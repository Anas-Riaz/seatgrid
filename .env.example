# Copy to .env to override defaults (docker compose reads it automatically).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REPLICATION_PASSWORD=replicator
AUTH_SECRET=change-me-in-production

# Dataset size (proposal scale). For a quick start try SEED_USERS=20000 SEED_EVENTS=20.
SEED_USERS=1000000
SEED_EVENTS=100
SEATS_PER_SECTION=1000

# Scale-out experiments: number of coordinators, and shards used by the seed (1-3).
API_REPLICAS=3
SHARD_COUNT=3

# Replication study: '' = asynchronous, '*' = synchronous.
SYNC_STANDBY_NAMES=
